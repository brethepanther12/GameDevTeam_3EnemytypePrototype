MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 167247462164014579}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c2b6f2bac90b7f47a2b94bed471c16a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mainPanel: {fileID: 4922901002419174896}
  cutsceneImage: {fileID: 2226643427265733518}
  narrativeText: {fileID: 8435552258403023682}
  continuePrompt: {fileID: 1620292023909646989}
  slides:
  - artwork: {fileID: 21300000, guid: 8f5a527d59b885543a0073a454e6e5f1, type: 3}
    narrativeText: We thought we were winning. Every bullet fired, every order followed...
      None of us knew we were already casualties of a deal made in silence.
    fadeInTime: 1
    typingSpeed: 0.04
  - artwork: {fileID: 21300000, guid: 3cabc246f9bc39e4e924715368c31899, type: 3}
    narrativeText: "We bled for each other. \nTrusted him with our lives. \nTurns
      out, that was the currency he traded."
    fadeInTime: 1
    typingSpeed: 0.04
  - artwork: {fileID: 21300000, guid: 0b3d6126e52f5114aad5969499df0c5a, type: 3}
    narrativeText: "When the world came back into focus, it wasn\u2019t the battlefield
      I saw. It was red lights, metal restraints, and the sound of alarms echoing
      in my head."
    fadeInTime: 1
    typingSpeed: 0.04
  sceneToLoadAfter: Tutorial
